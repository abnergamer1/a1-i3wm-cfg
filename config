# i3 config file (v4)

# Please see https://i3wm.org/docs/userguide.html for a complete reference!
# Default Modifier is SUPER (Win) Key:
set $mod Mod4

# Font for window titles. Will also be used by the bar unless a different font
# is used in the bar {} block below.
font pango:L337-MPT 20

# This font is widely installed, provides lots of unicode glyphs, right-to-left
# text rendering and scalability on retina/hidpi displays (thanks to pango).
font pango:L337-MPT 20

# C U S T O M   S E T T I N G S   H E R E
# Pipewire
exec --no-startup-id pipewire
exec --no-startup-id pipewire-pulse
exec --no-startup-id wireplumber
# Teclados alternativos
exec_always --no-startup-id setxkbmap -layout "br,br" -variant ",nodeadkeys" -option "grp:shifts_toggle"

# DUNST
exec --no-startup-id dunst

# Enable window focus following the mouse movement
focus_follows_mouse yes

#    Screenshot
bindsym $mod+Print exec scrot '%Y-%m-%d-%H%M%S_$wx$h_scrot_linux_i3wm_abner.png' -e 'mv $f ~/SYNC/scrot/ && xclip -selection clipboard -t image/png -i ~/SYNC/scrot/$f'

bindsym Ctrl+Print exec scrot '%Y-%m-%d-%H%M%S_$wx$h_scrot_linux_i3wm_abner.png' -e 'mv $f ~/SYNC/scrot/ && xclip -selection clipboard -t image/png -i ~/SYNC/scrot/$f'

#    NO TITLE BAR
for_window [class="^.*"] border pixel 1

# Quando janela começar, leve a outro worspace
# exec_always --no-startup-id ~/.config/i3/singlewindow_start.sh

# DMENU
bindsym $mod+d exec "dmenu_run -nf '#BBFFBB' -nb '#222222' -sb '#005577' -sf '#EEEEEE' -fn 'L337\-MPT-20' -p 'EXECUTE:'"

# Congelar a janela atualmente focada
bindsym Mod4+p exec sh -c 'kill -STOP $(xdotool getwindowpid $(xdotool getactivewindow))'

# Retomar a janela atualmente focada
bindsym Mod4+Shift+p exec sh -c 'kill -CONT $(xdotool getwindowpid $(xdotool getactivewindow))'

#    Open programs / Codes (custom, ignore)
bindsym Mod4+F1 exec sh -c '/usr/bin/sus'
bindsym Mod4+Shift+Ctrl+F1 exec sh -c '/usr/bin/off'

bindsym Mod4+F2 exec bash '/usr/bin/dim'
bindsym Mod4+Shift+F2 exec bash '/usr/bin/dim.5'

bindsym Mod4+F3 exec bash '/usr/bin/4x3'
bindsym Mod4+Shift+F3 exec bash '/usr/bin/800x600'
bindsym Mod4+Mod1+F3 exec bash '/usr/bin/1024'
bindsym Mod4+Ctrl+F3 exec bash '/usr/bin/ogres'

bindsym Mod4+F4 exec bash '/usr/bin/fm'
bindsym Mod4+Shift+F4 exec bash '/usr/bin/hel'

bindsym Mod4+F5 exec bash '/usr/bin/rec'
bindsym Mod4+Shift+F5 exec sh -c '/usr/bin/audacity'

bindsym Mod4+F6 exec i3-sensible-terminal -e '/usr/bin/e'
bindsym Mod4+Shift+F6 exec i3-sensible-terminal -e '/usr/bin/synt'

bindsym Mod4+F7 exec bash '/usr/bin/mpt'
bindsym Mod4+Shift+F7 exec bash '/home/abner/links/fb2k'

bindsym Mod4+F8 exec bash '/home/abner/links/u98'
bindsym Mod4+Shift+F8 exec bash '/home/abner/links/ut99'

bindsym Mod4+F9 exec bash '/home/abner/links/doom'
bindsym Mod4+Shift+F9 exec bash '/home/abner/links/quake'

bindsym Mod4+F10 exec bash '/home/abner/links/scd'
bindsym Mod4+Shift+F10 exec bash '/home/abner/links/sms2'

bindsym Mod4+F11 exec bash '/usr/bin/inv'
#bindsym Mod4+Shift+F11 exec bash './'

bindsym Mod4+F12 exec sh -c 'pactl set-sink-volume 0 +2%'
bindsym Mod4+Shift+F12 exec sh -c 'pactl set-sink-volume 0 -2%'


# Start XDG autostart .desktop files using dex. See also
# https://wiki.archlinux.org/index.php/XDG_Autostart
# exec --no-startup-id dex --autostart --environment i3

# The combination of xss-lock, nm-applet and pactl is a popular choice, so
# they are included here as an example. Modify as you see fit.

# xss-lock grabs a logind suspend inhibit lock and will use i3lock to lock the
# screen before suspend. Use loginctl lock-session to lock your screen.
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork

# NetworkManager is the most popular way to manage wireless networks on Linux,
# and nm-applet is a desktop environment-independent system tray GUI for it.
# exec --no-startup-id nm-applet

# Use pactl to adjust volume in PulseAudio.
set $refresh_i3status killall -SIGUSR1 i3status
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +10% && $refresh_i3status
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -10% && $refresh_i3status
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && $refresh_i3status
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && $refresh_i3status

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# move tiling windows via drag & drop by left-clicking into the title bar,
# or left-clicking anywhere into the window while holding the floating modifier.
tiling_drag modifier titlebar

# start a terminal
bindsym $mod+Return exec xfce4-terminal
# MOD THIS FILE!
bindsym $mod+Shift+Return exec i3-sensible-terminal -e 'sudo cfg'
bindsym Ctrl+Mod1+T exec i3-sensible-terminal

# kill focused window
bindsym Mod1+F4 kill

# start dmenu (a program launcher)
#bindsym $mod+d exec --no-startup-id dmenu_run
# A more modern dmenu replacement is rofi:
# bindcode $mod+40 exec "rofi -modi drun,run -show drun"
# There also is i3-dmenu-desktop which only displays applications shipping a
# .desktop file. It is a wrapper around dmenu, so you need that installed.
# bindcode $mod+40 exec --no-startup-id i3-dmenu-desktop

# change focus (hjkl VIM mode)
bindsym $mod+j focus left
bindsym $mod+k focus up
bindsym $mod+l focus down
bindsym $mod+ccedilla focus right

# alternatively, you can use the cursor keys:
bindsym $mod+Down focus down
bindsym $mod+Up focus up
# código para mudar de workspace caso só 1 janela no atual:
bindsym $mod+Tab exec --no-startup-id ~/.config/i3/mod_tab_logic.sh
bindsym Mod1+Tab exec --no-startup-id ~/.config/i3/workspace_logic.sh next
bindsym $mod+Left focus left
bindsym $mod+Right focus right
bindsym $mod+Prior exec --no-startup-id ~/.config/i3/workspace_logic.sh     
bindsym $mod+Next exec --no-startup-id ~/.config/i3/workspace_logic.sh next 
