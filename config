# bindsym $mod+KP_Next exec --no-startup-id ~/.config/i3/workspace_logic.sh next 

# move focused window
bindsym $mod+Shift+j move left
bindsym $mod+Shift+k move down
bindsym $mod+Shift+l move up
bindsym $mod+Shift+ccedilla move right

# alternatively, you can use the cursor keys:
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle

# change container layout (stacked, tabbed, toggle split)
bindsym $mod+s layout stacking ; fullscreen disable ; floating disable
bindsym $mod+w layout tabbed ; fullscreen disable ; floating disable
bindsym $mod+e layout toggle split ; fullscreen disable ; floating disable
# split in horizontal / verical orientation
bindsym $mod+h split h
bindsym $mod+v split v

# toggle tiling / floating
bindsym $mod+space floating toggle ; fullscreen disable

# Alternative: Make it 1/2 of the screen size (centered)
# Centralizar janela e colocá-la com metade do tamanho
# Janela pequena flutuante
bindsym $mod+Mod1+space floating toggle; resize set 50 ppt 50 ppt; move position 25 ppt 0 ppt ; fullscreen disable
for_window [class="feh"] floating enable, resize set 50 ppt 50 ppt, move position 25 ppt 0 ppt

# change focus between tiling / floating windows
